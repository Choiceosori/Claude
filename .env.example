# Postgres connection string (Neon, Supabase, Vercel Postgres, or any
# standard Postgres host work). On Vercel, set this in Project Settings →
# Environment Variables — see the Vercel section in README.md.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Vercel Blob read-write token, from Project Settings → Storage → your Blob
# store → ".env.local" tab. Required for sheet-music/video upload & playback.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Secret used to sign teacher/student session cookies. Change this in production.
SESSION_SECRET="change-me-to-a-long-random-string"

# The sole admin account, (re)synced by prisma/seed.ts on every `npm run build`.
# Change these in production — the defaults below match README.md's example.
# ADMIN_USERNAME="teacher"
# ADMIN_PASSWORD="teacher1234"
# ADMIN_NAME="관리자"
