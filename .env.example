# Local SQLite database file (school-hosted, no external DB needed).
# Relative paths are resolved relative to prisma/schema.prisma, not the
# project root, so "file:./dev.db" here means prisma/dev.db on disk.
# On Railway (or any host with a mounted persistent volume), use an
# absolute path into the volume instead, e.g. DATABASE_URL="file:/data/dev.db"
# and UPLOAD_DIR="/data/uploads" — see the Railway section in README.md.
DATABASE_URL="file:./dev.db"

# Secret used to sign teacher/student session cookies. Change this in production.
SESSION_SECRET="change-me-to-a-long-random-string"

# Where uploaded videos / sheet music are stored on disk.
UPLOAD_DIR="./storage/uploads"
